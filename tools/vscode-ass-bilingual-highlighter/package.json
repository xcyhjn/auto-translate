{
  "name": "autosub-zh-ass-bilingual-highlighter",
  "displayName": "Autosub ZH ASS Bilingual Highlighter",
  "description": "Syntax highlighting for bilingual ASS/SSA subtitles generated by autosub_zh.",
  "version": "0.1.0",
  "publisher": "autosub-zh-local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ass",
        "aliases": [
          "ASS",
          "SSA",
          "Advanced SubStation Alpha"
        ],
        "extensions": [
          ".ass",
          ".ssa"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ass",
        "scopeName": "source.ass",
        "path": "./syntaxes/ass-bilingual.tmLanguage.json"
      }
    ]
  }
}
